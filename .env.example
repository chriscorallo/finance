# Copy to .env.local and fill in real values for your own Supabase project.
# Never commit .env.local (or any .env* other than this file — see .gitignore).
# This file must never contain real or realistic-looking secret values.

# --- Client-safe (bundled into the browser) ---
NEXT_PUBLIC_SUPABASE_URL=
# Accepts either name — the Vercel Marketplace Supabase integration has used
# both across its rollout (src/lib/env.client.ts falls back automatically).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Server-only (never exposed to the browser; src/lib/env.server.ts) ---
# Accepts either name, same as above (SUPABASE_SERVICE_ROLE_KEY as fallback).
SUPABASE_SECRET_KEY=
# Base64-encoded 32-byte AES-256-GCM key: generate with `openssl rand -base64 32`
PROVIDER_TOKEN_ENCRYPTION_KEY=
# The single email address permitted to hold the owner account
OWNER_EMAIL=

# --- Plaid (server-only; not needed until Phase 3) ---
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SANDBOX_SECRET=
PLAID_DEVELOPMENT_SECRET=
PLAID_PRODUCTION_SECRET=

# --- Calendar integrations (server-only; not needed until the Schedule
# feature is connected). Google/Microsoft are OAuth apps you register once;
# Apple needs no client id/secret — each Apple connection stores its own
# app-specific password instead. ---
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_TENANT=common

# --- Owner provisioning script only (scripts/provision-owner.ts) ---
# Not read by the Next.js app itself — pass these as one-off shell env vars
# when running `pnpm run provision-owner`, not as persistent .env values.
# SUPABASE_URL=
# OWNER_PASSWORD=

# --- E2E tests only (see TESTING.md) ---
# E2E_OWNER_EMAIL=
# E2E_OWNER_PASSWORD=
# E2E_OWNER_TOTP_SECRET=
